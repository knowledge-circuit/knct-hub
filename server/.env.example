# All settings are prefixed with KNCT_ except DATABASE_URL (BaseSettings default).
# Example: KNCT_PORT=8765 → Settings.port

# Database connection string. SQLAlchemy URL form.
# SQLite default:
#   KNCT_DATABASE_URL=sqlite+aiosqlite:///~/.knct/hub.db
# Postgres example:
#   KNCT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/knct

KNCT_HOST=127.0.0.1
KNCT_PORT=8765

# Run alembic upgrade head on startup. Set to false in environments where
# migrations are handled by the deploy pipeline.
KNCT_AUTO_MIGRATE=true

KNCT_LOG_LEVEL=INFO
