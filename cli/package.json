{
  "name": "@knct/cli",
  "version": "0.2.0",
  "description": "Local-first kpatch installer for Claude Code.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledge-circuit/knct-hub.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/knowledge-circuit/knct-hub#readme",
  "bugs": "https://github.com/knowledge-circuit/knct-hub/issues",
  "bin": {
    "knct": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "manifest": "node scripts/build-manifest.mjs",
    "dev": "pnpm run manifest && tsx src/cli.ts",
    "build": "pnpm run manifest && esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --packages=external --loader:.py=text --loader:.sh=text --loader:.md=text --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js && chmod +x dist/cli.js",
    "pack:dry": "pnpm run build && npm pack --dry-run"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
